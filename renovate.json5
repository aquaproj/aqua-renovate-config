{
  extends: [
    'github>suzuki-shunsuke/renovate-config#4.0.0',
    'github>suzuki-shunsuke/renovate-config:nolimit#4.0.0',
    'github>aquaproj/aqua-renovate-config#2.13.0',
    'github>aquaproj/aqua-renovate-config:file#2.13.0(aqua/imports/.*\\.ya?ml)',
  ],
  customManagers: [
    {
      // Versions of Renovate and Node.js used by scripts/test.sh
      customType: 'regex',
      managerFilePatterns: [
        '/^scripts\\/test\\.sh$/',
      ],
      matchStrings: [
        '_version=(?<currentValue>\\S+) +# renovate: depName=(?<depName>\\S+)',
      ],
      datasourceTemplate: 'npm',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/README\\.md/',
      ],
      matchStrings: [
        '(version|ref): "?(?<currentValue>.*)"? +# renovate: depName=(?<depName>.*)',
      ],
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/README\\.md/',
      ],
      matchStrings: [
        '"github>aquaproj/aqua-renovate-config#(?<currentValue>[^" \\n\\(]+)',
        '"github>aquaproj/aqua-renovate-config:.*#(?<currentValue>[^" \\n\\(]+)',
        '"github>aquaproj/aqua-renovate-config/.*#(?<currentValue>[^" \\n\\(]+)',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'aquaproj/aqua-renovate-config',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/README\\.md/',
      ],
      matchStrings: [
        ' +[\'"]?aqua_version[\'"]? *: +[\'"]?(?<currentValue>[^\'" \\n]+)[\'"]?',
      ],
      depNameTemplate: 'aquaproj/aqua',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/README\\.md/',
      ],
      matchStrings: [
        'raw\\.githubusercontent\\.com/aquaproj/aqua-installer/(?<currentValue>.*?)/aqua-installer',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'aquaproj/aqua-installer',
    },
  ],
}
